# Copy to .env and edit. Never commit .env.
#
# Generate a strong secret:
#   openssl rand -base64 48

POSTGRES_DB=taskhub
POSTGRES_USER=taskhub
POSTGRES_PASSWORD=change-me-strong-db-password

# Base64, at least 32 bytes decoded. The API refuses to start with a weak/missing value.
TASKHUB_JWT_SECRET=

# Comma-separated browser origins allowed to call the API.
# For the bundled web client served by nginx this is the web origin.
TASKHUB_CORS_ORIGINS=http://localhost:8081

# First-run administrator (optional; only used when no ADMIN exists yet).
# Must be at least 12 characters with at least one letter and one digit.
TASKHUB_BOOTSTRAP_ADMIN_EMAIL=
TASKHUB_BOOTSTRAP_ADMIN_PASSWORD=
TASKHUB_BOOTSTRAP_ADMIN_NAME=Administrator

TASKHUB_LOG_LEVEL=INFO
TASKHUB_HEALTH_DETAILS=never
TASKHUB_DB_POOL_SIZE=10
API_PORT=8080
WEB_PORT=8081
POSTGRES_PORT=5432
